# ================================================================
# PINTEREST 7-ACCOUNT CREDENTIALS CONFIGURATION (.env)
# ================================================================
# Har account ki _pinterest_sess cookie value yahan paste karein.
# Board name optional hai. Agar khali chhodenge toh account ka pehla board auto-select hoga.

# Account 1
SESSION_ID_1=PASTE_SESSION_ID_1_HERE
BOARD_NAME_1=

# Account 2
SESSION_ID_2=PASTE_SESSION_ID_2_HERE
BOARD_NAME_2=

# Account 3
SESSION_ID_3=PASTE_SESSION_ID_3_HERE
BOARD_NAME_3=

# Account 4
SESSION_ID_4=PASTE_SESSION_ID_4_HERE
BOARD_NAME_4=

# Account 5
SESSION_ID_5=PASTE_SESSION_ID_5_HERE
BOARD_NAME_5=

# Account 6
SESSION_ID_6=PASTE_SESSION_ID_6_HERE
BOARD_NAME_6=

# Account 7
SESSION_ID_7=PASTE_SESSION_ID_7_HERE
BOARD_NAME_7=

# ================================================================
# GENERAL SETTINGS
# ================================================================
HEADLESS=false
DELAY_BETWEEN_ACCOUNTS=30
RANDOM_JITTER=15
ALTER_IMAGE_HASH=true
